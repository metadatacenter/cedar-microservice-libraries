<?xml version="1.0" encoding="UTF-8"?>
<!--
  Without a configuration, logback sent this module's DEBUG lines to the console, most of them the
  Apache HTTP client's wire and header log, and they made up about two thirds of the repository's
  CI log. Tests that read a logger's events set that logger's level themselves.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.apache.http" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
