<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-microservice-libraries</artifactId>
    <version>2.9.29-SNAPSHOT</version>
  </parent>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-logging-operations-library</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR Logging Operations Library</name>

  <properties>
    <!-- Line coverage measured on 2026-10-19: 86.5%. The build fails below this floor. -->
    <cedar.coverage.line.minimum>0.84</cedar.coverage.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>


    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-queue-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-hibernate</artifactId>
    </dependency>

    <!-- LogQueryBuilder is a pure spec->SQL function, so its contract is unit-testable with no DB. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The queue-service test fixture - a real Redis on a free port, and the cache configuration
      pointed at it - shared from the library that owns the queue services. Test-scope dependencies
      are not transitive, so the embedded server is declared alongside it; both versions come from
      cedar-parent.
    -->
    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-queue-operations-library</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.github.codemonstur</groupId>
      <artifactId>embedded-redis</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The DAOs run native SQL written for the log database, so their tests run it against an
      in-process MariaDB through the driver the servers use. The test support library has the same
      fixture, but it depends on this library.
    -->
    <dependency>
      <groupId>ch.vorburger.mariaDB4j</groupId>
      <artifactId>mariaDB4j</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- The embedded MariaDB's platform binaries come from an OS-activated profile, since profiles do not travel with
       dependencies. -->
  <profiles>
    <profile>
      <id>embedded-mariadb-mac-arm64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.vorburger.mariaDB4j</groupId>
          <artifactId>mariaDB4j-db-macos-arm64</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>embedded-mariadb-linux64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.vorburger.mariaDB4j</groupId>
          <artifactId>mariaDB4j-db-linux64</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>embedded-mariadb-winx64</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>ch.vorburger.mariaDB4j</groupId>
          <artifactId>mariaDB4j-db-winx64</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
